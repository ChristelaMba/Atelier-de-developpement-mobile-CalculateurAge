<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Title="ResultatPage">
    <VerticalStackLayout Padding="20" Spacing="16">
        <!-- Les textes viennent du ViewModel, plus de x:Name. -->
        <Label Text="{Binding Resultat}" FontSize="22"/>
        <Label Text="{Binding Message}" FontSize="18"/>
        <Label Text="{Binding JoursRestants}" FontSize="16"/>
        <Button Text="Retour" Clicked="OnRetourClicked"/>
    </VerticalStackLayout>
</ContentPage>