<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
               Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>
            <Button Text="Calculer"
                Command="{Binding CalculerCommand}"/>
            <Label Text="{Binding Resultat}" FontSize="20"
               IsVisible="{Binding ResultatVisible}"/>

            <!-- Affiche Majeur ou Mineur, visible en meme temps que le resultat. -->
            <Label Text="{Binding Message}" FontSize="18"
                    IsVisible="{Binding ResultatVisible}"/>

            <!-- Affiche les jours restants avant le prochain anniversaire. -->
            <Label Text="{Binding JoursRestants}" FontSize="16"
                    IsVisible="{Binding ResultatVisible}"/>

            <!-- Bouton qui remet tous les champs a zero. -->
            <Button Text="Effacer"
                    Command="{Binding EffacerCommand}"/>

            <!-- Titre de la liste des calculs. -->
            <Label Text="Historique" FontSize="18" FontAttributes="Bold"/>

            <!-- Affiche chaque element de la liste Historique, un Label par ligne. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historique}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" FontSize="14"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
