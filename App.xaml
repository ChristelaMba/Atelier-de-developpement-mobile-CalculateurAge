<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CalculateurAge"
             x:Class="CalculateurAge.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- couleurs -->
            <Color x:Key="Teal600">#2F8F8F</Color>
            <Color x:Key="Teal900">#075F63</Color>
            <Color x:Key="Teal100">#E8F2F2</Color>
            <Color x:Key="Teal200">#C4DFDA</Color>
            <Color x:Key="TexteFort">#172033</Color>
            <Color x:Key="TexteDoux">#6B7280</Color>
            <Color x:Key="Trait">#E3EAEA</Color>
            <Color x:Key="VertClair">#E1F0E4</Color>
            <Color x:Key="VertTexte">#2F7A4D</Color>
            <Color x:Key="Corail">#E87868</Color>
            <Color x:Key="CorailTexte">#D9604F</Color>

            <!-- pinceaux -->
            <SolidColorBrush x:Key="TraitBrush" Color="#E3EAEA"/>
            <SolidColorBrush x:Key="ChampBrush" Color="#BCC8CC"/>
            <SolidColorBrush x:Key="Teal200Brush" Color="#C4DFDA"/>
            <SolidColorBrush x:Key="Deco1Brush" Color="#C4DFDA"/>
            <SolidColorBrush x:Key="Deco2Brush" Color="#D3E7E3"/>

            <!-- carte -->
            <Style x:Key="Carte" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="{StaticResource TraitBrush}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- champ de saisie -->
            <Style x:Key="Champ" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="{StaticResource ChampBrush}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- petite carte de l'historique -->
            <Style x:Key="CartePetite" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="{StaticResource TraitBrush}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- etiquette au-dessus d'un champ -->
            <Style x:Key="Etiquette" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TexteDoux}"/>
                <Setter Property="TextTransform" Value="Uppercase"/>
                <Setter Property="CharacterSpacing" Value="1"/>
            </Style>

            <!-- titre de section -->
            <Style x:Key="TitreSection" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TexteFort}"/>
            </Style>

            <!-- bouton principal : teal plein -->
            <Style x:Key="BoutonPrincipal" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Teal600}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="MinimumHeightRequest" Value="52"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#86B8B8"/>
                                    <Setter Property="TextColor" Value="White"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- bouton secondaire : teal clair -->
            <Style x:Key="BoutonSecondaire" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Teal100}"/>
                <Setter Property="TextColor" Value="{StaticResource Teal900}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="MinimumHeightRequest" Value="46"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#EEF3F3"/>
                                    <Setter Property="TextColor" Value="#7C9A9A"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- bouton Effacer : contour corail -->
            <Style x:Key="BoutonEffacer" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="{StaticResource CorailTexte}"/>
                <Setter Property="BorderColor" Value="{StaticResource Corail}"/>
                <Setter Property="BorderWidth" Value="1.5"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="MinimumHeightRequest" Value="46"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>